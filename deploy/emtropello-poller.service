[Unit]
Description=EMTropello · poller de posicions GPS d'EMT València (geoportal ArcGIS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roca
WorkingDirectory=/home/roca/EMTropello
ExecStart=/home/roca/EMTropello/.venv/bin/python -m backend.poller --interval 15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
