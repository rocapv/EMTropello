[Unit]
Description=EMTropello · API + frontend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roca
WorkingDirectory=/home/roca/EMTropello
# Solo localhost: el acceso LAN llega por Apache (/EMT), nunca directo a :8791
ExecStart=/home/roca/EMTropello/.venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8791 --root-path /EMT
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
